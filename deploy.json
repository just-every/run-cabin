{
  "version": 1,
  "project": "holiday/cabin",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "INSTALLATION_KEY",
      "environment": "INSTALLATION_KEY"
    },
    {
      "binding": "INSTALLATION_KEY_PREVIOUS",
      "environment": "INSTALLATION_KEY_PREVIOUS",
      "optional": true
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "STRIPE_TEST_SECRET_KEY",
      "environment": "STRIPE_TEST_SECRET_KEY",
      "optional": true
    },
    {
      "binding": "STRIPE_SECRET_KEY",
      "environment": "STRIPE_SECRET_KEY",
      "optional": true
    },
    {
      "binding": "SEAM_API_KEY",
      "environment": "SEAM_API_KEY",
      "optional": true
    },
    {
      "binding": "TWILIO_ACCOUNT_SID",
      "environment": "TWILIO_ACCOUNT_SID",
      "optional": true
    },
    {
      "binding": "TWILIO_AUTH_TOKEN",
      "environment": "TWILIO_AUTH_TOKEN",
      "optional": true
    },
    {
      "binding": "TWILIO_FROM",
      "environment": "TWILIO_FROM",
      "optional": true
    },
    {
      "binding": "CABIN_WORKER_NAME",
      "environment": "CABIN_WORKER_NAME",
      "optional": true
    }
  ],
  "crons": [
    "*/5 * * * *"
  ]
}
