{
  "push": [
    {
      "name": "domain-operations",
      "browser": false,
      "hosted": false,
      "commands": [
        "node scripts/contract-docs.mjs check",
        "node scripts/cabin-domain-tests.mjs operations",
        "pnpm run check --profile first-party",
        "pnpm run test:site"
      ]
    },
    {
      "name": "domain-finance",
      "browser": false,
      "hosted": false,
      "commands": [
        "node scripts/cabin-domain-tests.mjs finance",
        "pnpm run typecheck"
      ]
    },
    {
      "name": "domain-guests",
      "browser": false,
      "hosted": false,
      "commands": [
        "node scripts/cabin-domain-tests.mjs guests"
      ]
    },
    {
      "name": "restart",
      "browser": false,
      "hosted": false,
      "commands": [
        "node scripts/cabin-domain-tests.mjs restart"
      ]
    },
    {
      "name": "restore",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:archive",
        "node --test --test-concurrency=1 tests/quotes-archive.test.mjs"
      ]
    },
    {
      "name": "channel-agent",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/channel-agent.test.mjs"
      ]
    },
    {
      "name": "readiness-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/readiness-browser.test.mjs",
        "node tests/financial-exceptions-browser.mjs",
        "node tests/qbo-browser.mjs",
        "node tests/recovery-browser.mjs"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "pnpm run test:runtime",
        "node --test --test-concurrency=1 tests/cleaner-mobile.test.mjs",
        "node --test --test-concurrency=1 tests/quotes-browser.test.mjs",
        "node --test --test-concurrency=1 tests/website-browser.test.mjs"
      ]
    }
  ],
  "nightly": [
    {
      "name": "clone",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run test:launch"
      ]
    }
  ]
}
