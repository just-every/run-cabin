{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run typecheck"
      ]
    },
    {
      "name": "domain",
      "browser": false,
      "hosted": false,
      "commands": [
        "node scripts/cabin-domain-tests.mjs core"
      ]
    },
    {
      "name": "restore",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:archive"
      ]
    },
    {
      "name": "site",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:site"
      ]
    },
    {
      "name": "cleaner-mobile",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/cleaner-mobile.test.mjs"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "pnpm run test:runtime"
      ]
    },
    {
      "name": "restart",
      "browser": false,
      "hosted": false,
      "commands": [
        "node scripts/cabin-domain-tests.mjs restart"
      ]
    },
    {
      "name": "channel-agent",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/channel-agent.test.mjs"
      ]
    },
    {
      "name": "quotes-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/quotes-browser.test.mjs"
      ]
    },
    {
      "name": "quotes-archive",
      "browser": false,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/quotes-archive.test.mjs"
      ]
    },
    {
      "name": "website-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/website-browser.test.mjs"
      ]
    },
    {
      "name": "readiness-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/readiness-browser.test.mjs",
        "node tests/financial-exceptions-browser.mjs",
        "node tests/qbo-browser.mjs",
        "node tests/recovery-browser.mjs"
